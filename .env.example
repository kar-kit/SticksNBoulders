# Appwrite. Endpoint lives in an env var from the first commit so the
# self-hosted -> Cloud migration (Jan 2027) is a config change, not a code change.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://appwrite.jp-homelab.work/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=

# Server-side only. Never prefixed NEXT_PUBLIC_, never committed.
APPWRITE_API_KEY=
