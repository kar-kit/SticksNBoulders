# Appwrite. The endpoint lives in an env var from the first commit so the
# self-hosted -> Cloud migration (Jan 2027) is a config change, not a code one.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://appwrite.jp-homelab.work/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=sticksnboulders

# Server-side only. Never prefixed NEXT_PUBLIC_, never committed.
# Used by the setup/reset scripts and by the sign-in method-hint route.
APPWRITE_API_KEY=

# Sign in with Apple. Off until an Apple Developer account and Services ID
# exist; the button is built but hidden rather than shown as one that fails.
# Not mandatory: App Store Review Guideline 4.8 applies to store-distributed
# apps, and this is a PWA with no store submission.
NEXT_PUBLIC_APPWRITE_APPLE_ENABLED=false

# Where npm run appwrite:backup writes, and where npm run clips:sweep looks for
# the backup that must cover anything it deletes. Defaults to .appwrite-backup/
# next to the repo. Clips are kept once under files/ in here, so size the disk
# for the bucket, not for the rows. See docs/backups.md.
SNB_BACKUP_DIR=.appwrite-backup

# Where npm run appwrite:backup copies each dump after writing it: an rsync
# destination, either a path on a mounted share or host:path over SSH. Must
# already exist, and must not be on the TrueNAS pool that holds the clips --
# a copy on the same pool is not off the machine. Empty means local only.
# A place, never a credential: SSH keys stay in ~/.ssh.
SNB_BACKUP_OFFSITE=

# Signs the short-lived URLs that serve clips to the coach. Any long random
# string; generate one with `openssl rand -base64 48`. Playback fails loudly
# without it rather than falling back to URLs anyone could mint.
VIDEO_TICKET_SECRET=
