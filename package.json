{
  "name": "sticksnboulders",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "appwrite:setup": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.local.env scripts/appwrite-setup.mts",
    "appwrite:reset": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.local.env scripts/appwrite-reset.mts",
    "appwrite:backup": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.local.env scripts/appwrite-backup.mts",
    "appwrite:restore": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.local.env scripts/appwrite-restore.mts",
    "appwrite:probe": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.local.env scripts/appwrite-permission-probe.mts",
    "e2e:auth": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.local.env scripts/e2e-auth.mts",
    "smtp:check": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.local.env scripts/smtp-check.mts",
    "perf:check": "tsx scripts/perf-check.mts",
    "e2e:backup": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.local.env scripts/e2e-backup.mts",
    "e2e:shell": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.local.env scripts/e2e-shell.mts"
  },
  "dependencies": {
    "appwrite": "^26.2.0",
    "next": "16.3.4",
    "node-appwrite": "^28.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
